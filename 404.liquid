<div class="my-5 px-3 d-flex flex-column" style="height: 75vh">
  <img id="image" src="/assets/404.png" alt="404" draggable="false"
    class="flex-fill d-block m-auto mw-100 object-fit-contain"
    style="image-rendering: crisp-edges; cursor: pointer">
  <audio id="music" autoplay loop
    controls controlslist="nodownload noremoteplayback noplaybackrate"
    class="d-block mx-auto mt-3 col-12 col-sm-10 col-md-9 col-xl-8 col-xxl-7">
    <source src="/assets/findher.ogg" type="audio/ogg">
    <source src="/assets/findher.mp3" type="audio/mp3">
  </audio>
</div>

<script>
  const image = document.getElementById("image")
  const music = document.getElementById("music")
  function playMusic() {
    music.volume = 0.3
    music.play()
    image.style.cursor = ""
    document.onmousedown = null
    document.onkeydown = null
    document.ontouchstart = null
  }

  document.onmousedown = playMusic
  document.onkeydown = playMusic
  document.ontouchstart = playMusic
</script>
